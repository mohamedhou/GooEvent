   -
     internal_properties : HwAAAB4AAADFAtYvhe+uoUIb3C2L1Ieg5QTsNAnozt4NtvRTcocnwyJhS2HnsnN/Tf8id6RRRL20YShPROcU7arjtuJlzVIVuw7KJz3w1E0CebFtyaeHuFoysktKt5oH95b2uNsD5bNZkiwJmu1rM+wAKycPd+P0XzlUc+66kNqcEQEwY7Uj0XertLM=
     code : |1+
      //Configure the operating mode of the AWP context
      //The content of the context will be saved in a file on the server
      //Regarding the transmission mode of the context identifier, the automatic mode was chosen: it is managed by WebDev
      //The identifier is transmitted by cookies. 
      //If the cookies do not operate, the identifier is transmitted by the URL.
      ConfigureAWPContext(ctxDisk, ctxIDCookieURL)
      
      //Structure for storing the filter applied to a given file and the current record in this file
      STFileContext is Structure
      	
      	//Filter applied
      	sNameFilterKey is string
      	vFilterValue is variant
      	
      	//Current position
      	sNamePositionKey is string
      	vPositionValue is variant	
      	
      end
      
      //Array for storing the filters and position of each file
      gaagarrMemoryContextFiles is array associatif of STFileContext
      //Array stored in the context
      DeclareAWPContext(gaagarrMemoryContextFiles)
     type : 720896
  procedures :
   -
     name : RADLoadPosition
     procedure_id : 1760906204531493933
     type_code : 15
     code : |1+
      // Summary: Loads the position and the filter of a given file
      // Syntax:
      //[ <Result> = ] RADLoadPosition (<sFile>)
      //
      // Parameters:
      //	sFile: File whose information about the position and the filter is requested
      // Return value:
      // 	boolean: True if we are not positioned on a record, False if there is a current record
      
      procedure RADLoadPosition(sFile)
      
      pstAFileContext is STFileContext dynamic
      pstAFileContext = new STFileContext
      
      //Search in the array for the structure corresponding to the file
      pstAFileContext = gaagarrMemoryContextFiles[sFile]
      
      //If it is found
      if pstAFileContext <> Null  then
      	
      	//If a filter is applied
      	if pstAFileContext:sNameFilterKey <> "" then 
      		
      		//Apply this filter
      		HFilter(sFile, pstAFileContext:sNameFilterKey, pstAFileContext:vFilterValue)
      		
      	end
      	
      	//If there is a current position
      	if pstAFileContext:sNamePositionKey <> "" then	
      		
      		//Read the record
      		HReadSeekFirst(sFile, pstAFileContext:sNamePositionKey, pstAFileContext:vPositionValue)			
      
      		//We are positioned on a specific record: return False (used for the forms: find out whether we are in creation mode or not)
      		result False 
      	
      	end	
      
      end
      
      //We are not positioned on a specific record
      result True
      
      
      
      
     type : 458752
   -
     name : RADSavePosition
     procedure_id : 1760906204531559469
     type_code : 15
     code : |1+
      // Summary: Saves the position and the filter of a given file
      // Syntax:
      //RADSavePosition (<sFile>, <bFilterToChange>, <sNameFilterKey>, <vFilterValue>, <bPositionToChange>, <sNamePositionKey>, <vPositionValue>)
      //
      // Parameters:
      //	sFile: File affected by the filter and the position
      //	bFilterToChange: Do we have to change the filter?
      //	sNameFilterKey: Name of the key for the current filter
      //	vFilterValue: Value of the key for the filter
      //	bPositionToChange: Do we have to change the position?
      //	sNamePositionKey: Name of the key for the current position
      //	vPositionValue: Value of the key for the position
      // Return value:
      // 	None
      
      procedure RADSavePosition(sFile,bFilterToChange, sNameFilterKey, vFilterValue,bPositionToChange, sNamePositionKey, vPositionValue)
      
      pstAFileContext is STFileContext dynamic
      
      //Search in the array for the structure corresponding to the file
      pstAFileContext = gaagarrMemoryContextFiles[sFile]
      
      //If not found: create a new structure to add to the array
      if pstAFileContext = Null then
      	
      	pstAFileContext = new STFileContext
      	//Fill the structure
      	pstAFileContext:sNameFilterKey = sNameFilterKey
      	pstAFileContext:vFilterValue = vFilterValue
      	pstAFileContext:sNamePositionKey = sNamePositionKey
      	pstAFileContext:vPositionValue = vPositionValue
      	
      	//Add to the array saved in the AWP context
      	gaagarrMemoryContextFiles[sFile] = pstAFileContext
      	
      else
      	
      	//If found
      	//Modify the array of "HF context" saved in the AWP context
      	
      	if bFilterToChange then
      		gaagarrMemoryContextFiles[sFile]:sNameFilterKey = sNameFilterKey
      		gaagarrMemoryContextFiles[sFile]:vFilterValue =  vFilterValue
      	end
      	
      	if bPositionToChange then
      		gaagarrMemoryContextFiles[sFile]:sNamePositionKey =  sNamePositionKey
      		gaagarrMemoryContextFiles[sFile]:vPositionValue =  vPositionValue
      	end
      	
      end
      
     type : 458752
   -
     name : RADLoadSelection
     internal_properties : HwAAAB4AAABvP9SEV7C+4A+oA9aonUYkFOSs9zQZWsK1h/dDrjFY2pshNb4xUp+zCdz+o+FcZ/NamsK1islDWJgSgCXEvMZ2HygVIy/yKD+RGEvKZXRPh9KPQmbico2T4fECiySrBQxsV7LV52max1jW6DV7UluRF7wVM/cTDBiAyLvT/+DOxAI36OCX01Q=
     procedure_id : 1760906204531625005
     type_code : 15
     code : |1-
      // Summary: Procedure that retrieves the selection that was made in a "vision" page
      // Syntax:
      //[ <Result> = ] RADLoadSelection (<sFileName>, <sItemName>)
      //
      // Parameters:
      //	sFileName: File whose previous selection must be retrieved
      //	sItemName: File item whose value must be retrieved for the selected record
      // Return value:
      // 	Undefined type: Value of the item passed in parameter for the selected record
      //
      
      procedure RADLoadSelection(sFileName, sItemName)
      
      RADLoadPosition(sFileName)
      
      result {sFileName + "." + sItemName, indItem}
     type : 458752
