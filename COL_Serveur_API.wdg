  procedures :
   -
     name : PROC_ClientLogin
     procedure_id : 1760836647490777256
     type_code : 15
     code : |1+
      //!
      //! @brief <specify the procedure action>
      //!
      //! @param sDonneesJSON (ANSI string)  <specify the role of sDonneesJSON>
      //!
      //!
      
      PROCEDURE PROC_ClientLogin(sDonneesJSON est une chaîne)
      // Étape 1 : Parser le JSON
      
      Infos est un Variant = JSONVersVariant(sDonneesJSON)
      SI Infos = Null ALORS
      	res est un Variant
      	res.success	= Faux
      	res.message	= "JSON invalide"
      	RENVOYER VariantVersJSON(res)
      FIN
      
      sIdentifiant	est une chaîne	= Infos.identifiant
      sMotDePasse		est une chaîne	= Infos.motdepasse
      // Étape 2 : Chercher le client
      SI  HLitRecherchePremier(utililisateur, email , sMotDePasse ) alors
      
      	SI  HLitRecherchePremier(utililisateur, telephone, sMotDePasse ) ALORS
      		res est un Variant
      		res.success	= Faux
      		res.message	= "Utilisateur introuvable."
      		RENVOYER VariantVersJSON(res)
      	FIN
      FIN
      
      
      
      
      // Étape 3 : Vérification du mot de passe
      SI client.MotDePasse() <> sMotDePasse ALORS
      	res est un Variant
      	res.success	= Faux
      	res.message	= "Mot de passe incorrect."
      	RENVOYER VariantVersJSON(res)
      FIN
      
      // Étape 4 : Session
      Session.EstConnecte	= VariableReset()
      Session.estConnecte	= Vrai
      Session.IDClient	= client.IDClient
      
      // Étape 5 : Réponse de succès
      res est un Variant
      res.success	= Vrai
      res.message	= "Connexion réussie."
      RENVOYER VariantVersJSON(res)
      
      
     type : 458752
