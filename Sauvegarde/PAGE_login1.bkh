           internal_properties : HwAAAB4AAAA4TIApOnZuS1rWiKRMpNx/J76QumUpH0JmxgCqFGA4ibM6r6bX4e4+BA4iwtTAoYdGIH4fpKdLQNNQcnPVqjFV/mE8T7J2Kz5fAwDGk9io7r/nn0FXVqbOnfF5
           code : |1+
            // Récupération des identifiants
            sEmail		est une chaîne	= SAI_Email
            sMotDePasse	est une chaîne	= SAI_MotDePasse
            
            // Vérification de base
            SI sEmail = "" OU sMotDePasse = "" ALORS
            	Info("Veuillez saisir votre e-mail et votre mot de passe.")
            	RETOUR
            FIN
            
            // Recherche de l'utilisateur
            SI HLitRecherche(utililisateur, email, sEmail) = Vrai ALORS
            	SI utililisateur.motDePasse = sMotDePasse ALORS
            		// Connexion réussie
            		// Mémoriser l'utilisateur connecté si besoin
            		// Exemple : Session.utilisateur = UTILISATEUR.ID
            		Info("Connexion réussie !")
            		sEmailUtilisateur	= utililisateur.email
            		sNomUtilisateur		= utililisateur.nom
            		sRoleUtilisateur	= utililisateur.role
            		nIDUtilisateur		= utililisateur.IDUtililisateur
            		PageAffiche(PAGE_Achat_billets)
            	SINON
            		Info("Mot de passe incorrect.")
            	FIN
            SINON
            	Info("Aucun utilisateur trouvé avec cet e-mail.")
            FIN
