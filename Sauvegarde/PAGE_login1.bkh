 type : 1
 languages :
  - en-GB
  - fr-FR
 code_elements :
  type_code : 38
  p_codes :
   -
     code : |1+
      PROCEDURE MaPage()
     type : 851968
   -
     code : |1-
      
     type : 852300
   -
     type : 852017
     enabled : false
   -
     type : 852119
     enabled : false
   -
     code : |1+
      // Cacher le message d'erreur si affiché précédemment
      LIB_Erreur.Visible = Faux
      
      // Vérification des champs requis
      SI SAI_Email..Valeur = "" OU SAI_MotDePasse..Valeur = "" ALORS
      	LIB_Erreur..Valeur	= "Veuillez remplir tous les champs."
      	LIB_Erreur.Visible	= Vrai
      	RETOUR // Ne pas envoyer au serveur
      FIN
      
      // Si tout est OK → appel automatique du code serveur
     type : 852298
     role : N
   -
     type : 851999
     role : N
   -
     type : 852000
     role : N
   -
     type : 852232
     enabled : false
   -
     code : |1-
      
      //-------------------------------------------------------------
      // Événement : Clic sur le bouton (Serveur)
      // Rôle : Vérifier les identifiants dans la base de données.
      //-------------------------------------------------------------
      
      // --- 1. Recherche de l'utilisateur ---
      // On cherche dans la table 'utilisateur' où la colonne 'email'
      // correspond à la valeur saisie dans le champ SAI_Email.
      // HAParam() est très important pour la sécurité.
      HLitRecherche(utililisateur, email, HAParam(SAI_Email))
      
      
      // --- 2. Vérification du résultat de la recherche ---
      SI HEnDehors(utililisateur) ALORS
      	// SI HEnDehors est Vrai, ça veut dire qu'on n'a rien trouvé.
      	// L'utilisateur avec cet email n'existe pas.
      
      	// On prépare le message d'erreur pour le libellé LIB_Erreur.
      	// "..ContenuServeur" va mettre à jour le libellé après le retour du serveur.
      	LIB_Erreur..Valeur	= " Email ou mot de passe incorrect."
      
      	// On active la visibilité du libellé d'erreur.
      	LIB_Erreur.Visible			= Vrai
      
      	// On arrête le code ici.
      	RETOUR
      FIN
      
      
      // --- 3. Si on arrive ici, l'utilisateur a été trouvé. On vérifie le mot de passe ---
      // ATTENTION : Cette comparaison est directe. Pour un vrai projet,
      // il FAUT utiliser un cryptage. Exemple :
      // SI utilisateur.motDePasse = Crypte(SAI_MotDePasse, "votre_clé_de_cryptage") ALORS
      SI utililisateur.hashMotDeePasse = SAI_MotDePasse ALORS
      
      	// Le mot de passe est correct !
      	// On affiche un message de bienvenue. "Info()" s'affiche côté client.
      	Info("Connexion réussie ! Bienvenue, " + utililisateur.prenom)
      
      	// On redirige l'utilisateur vers la page d'accueil.
      	PageAffiche(PAGE_Home)
      	
      SINON
      
      	// Le mot de passe est incorrect.
      	LIB_Erreur..Valeur	= "Email ou mot de passe incorrect."
      	LIB_Erreur.Visible			= Vrai
      
      FIN
