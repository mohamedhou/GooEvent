           code : |1-
            <§rad:1§>
            // Are we coming from a page?<§rad:1§>
            if gsNamePreviousPage<>"" then<§rad:1§>
            	// Yes, display this page<§rad:1§>
            	PageDisplay(gsNamePreviousPage, MyPage.Name)<§rad:1§>
            else<§rad:1§>
            	// No, go back to the home page<§rad:1§>
            	PAGE_Home.Display()	<§rad:1§>
            end<§rad:1§>
            <§rad:1§>
