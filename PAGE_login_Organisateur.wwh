     -
       name : HTM_SansNom1
       identifier : 0x287578f70ab006c9
       internal_properties : 
       properties :
        x : 70
        y : 308
        width : 301
        height : 42
        alias : A14
        aaf :
         - -1
         - -1
       style : {}
       type : 12
       code_elements :
        type_code : 4
        alias : A14
        p_codes :
         -
           code : |1-
            
           type : 851980
         -
           code : |1-
            
           type : 851998
           role : B
         -
           internal_properties : HwAAAB4AAAA4TIApOnZuS1rWiKRMpNx/J76QumUpH0JmxgCqFGA4ibM6r6bX4e4+BA4iwtTAoYdGIH4fpKdLQNNQcnPVqjFV/mE8T7J2Kz5fAwDGk9io7r/nn0FXVqbOnfF5
           code : |1-
            // Récupération des identifiants
            sEmail		est une chaîne	= SAI_Email
            sMotDePasse	est une chaîne	= SAI_MotDePasse
            
            // Vérification de base
            SI sEmail = "" OU sMotDePasse = "" ALORS
            	Info("Veuillez saisir votre e-mail et votre mot de passe.")
            	RETOUR // On arrête l'exécution ici
            FIN
            
            // On cherche l'utilisateur dans la base de données avec son email
            // On utilise le nom correct de la table : "utilisateur"
            SI HLitRecherche(utililisateur, email, sEmail) = Vrai ALORS
            	// L'utilisateur a été trouvé. Maintenant on vérifie le mot de passe.
            
            	// !! LA CORRECTION IMPORTANTE EST ICI !!
            	// On crypte le mot de passe saisi et on le compare avec celui de la BDD
            	// Assurez-vous que le nom de la colonne est bien "motDePasse" dans votre analyse
            	SI sMotDePasse = utililisateur.hashMotDeePasse ALORS
            		// Connexion réussie !
            		Info("Connexion réussie ! Bienvenue " + utililisateur.nom)
            
            		// Optionnel : Mémoriser l'utilisateur dans une variable globale ou de session
            		sEmailUtilisateur		= utililisateur.email
            		sNomUtilisateur		= utililisateur.nom
            		sRoleUtilisateur		= utililisateur.role
            		nIDUtilisateur		= utililisateur.IDUtililisateur
            
            		// !! LA CORRECTION DE LOGIQUE EST ICI !!
            		// On redirige vers la page principale, pas la page d'inscription
            		PageAffiche(PAGE_FilterEvenements)
            	SINON
            		// Le mot de passe est faux
            		Erreur("Mot de passe incorrect.")
            	FIN
            SINON
            	// Aucun utilisateur n'a été trouvé avec cet email
            	Erreur("Aucun utilisateur trouvé avec cet e-mail.")
            FIN
           type : 851984
