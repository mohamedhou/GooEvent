 code_elements :
  type_code : 38
  p_codes :
   -
     code : |1+
      PROCEDURE MaPage()
     type : 851968
   -
     code : |1-
      
     type : 852300
   -
     type : 852017
     enabled : false
   -
     type : 852119
     enabled : false
   -
     code : |1-
      
      LIB_Erreur.Visible = Faux
      
      SI SAI_Email..Valeur = "" OU SAI_MotDePasse..Valeur = "" ALORS
      	LIB_Erreur..Valeur	= ""
      	LIB_Erreur.Visible	= Vrai
      
      	RETOUR
      FIN
     type : 852298
     role : B
   -
     code : |1-
      
     type : 851999
     role : B
   -
     type : 852000
     role : B
   -
     type : 852232
     enabled : false
   -
     code : |1-
      
      SI HEnDehors(utililisateur) ALORS
      	LIB_Erreur..Valeur			= ""
      	LIB_Erreur.Visible			= Vrai
      	RETOUR
      FIN
      
      SI utililisateur.MotDePasse = SAI_MotDePasse ALORS
      
      	Info("Connexion réussie ! Bienvenue, " + utililisateur.prenom)
      
      	PageAffiche(PAGE_Achat_billets)
      
      SINON
      
      	LIB_Erreur..Valeur	= "Email ou mot de passe incorrect."
      	LIB_Erreur.Visible			= Vrai
      
      FIN
