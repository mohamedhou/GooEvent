     -
       name : BTN_SansNom1
       identifier : 0x28757d3c1106b23e
       internal_properties : 
       properties :
        x : 111
        y : 529
        width : 217
        height : 37
        alias : A16
        tab_order : 7
        color : 2960685
        background_color : 10401993
        aaf :
         - -1
         - -1
       style : {}
       type : 4
       code_elements :
        type_code : 4
        alias : A16
        p_codes :
         -
           type : 851998
           role : B
         -
           internal_properties : HwAAAB4AAAA4TIApOnZuS1rWiKRMpNx/J76QumUpH0JmxgCqFGA4ibM6r6bX4e4+BA4iwtTAoYdGIH4fpKdLQNNQcnPVqjFV/mE8T7J2Kz5fAwDGk9io7r/nn0FXVqbOnfF5
           code : |1+
            // Récupération des valeurs saisies
            sNom			est une chaîne	= SAI_Nom
            sPrenom			est une chaîne	= SAI_Prenom
            sEmail			est une chaîne	= SAI_Email
            sTelephone		est une chaîne	= SAI_Telephone
            sMotDePasse		est une chaîne	= SAI_MotDePasse1
            sConfirmation	est une chaîne	= SAI_MotDePasse2
            
            SI sNom = "" OU sEmail = "" OU sMotDePasse = "" OU sConfirmation = "" ALORS
            	Info("Tous les champs obligatoires doivent être remplis.")
            	RETOUR
            FIN
            
            SI sMotDePasse <> sConfirmation ALORS
            	Info("Les mots de passe ne correspondent pas.")
            	RETOUR
            FIN
            
            // Vérifie si l'utilisateur existe déjà
            SI HLitRecherche(utililisateur, email, sEmail) ALORS
            	Info("Un utilisateur avec cet e-mail existe déjà.")
            	RETOUR
            FIN
            
            // Ajoute le nouvel utilisateur
            utililisateur.nom			= sNom
            utililisateur.prenom		= sPrenom
            utililisateur.email		= sEmail
            utililisateur.telephone	= sTelephone
            utililisateur.motDePasse= sMotDePasse
            utililisateur.role       = "organisateur"
            
            SI HAjoute(utililisateur) ALORS
            	Info("Inscription réussie !")
            	PageAffiche(PAGE_login_Organisateur)
            SINON
            	Info("Erreur lors de l'inscription.")
            FIN
           type : 851984
         -
           type : 1310736
           enabled : false
         -
