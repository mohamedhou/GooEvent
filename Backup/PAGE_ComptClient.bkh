             style : {}
             type : 4
             code_elements :
              type_code : 4
              alias : A5
              p_codes :
               -
                 code : |1-
                  <§rad:1§>
                  <§rad:1§>
                 type : 851998
                 role : B
               -
                 internal_properties : HwAAAB4AAACi2t5NAO7LDxeQR24xQRAjm8NP5k9IhYFzJBLJ67NgQv5dm0HLqW47ic949AxmxLVNvhHFM5rNLVlEkCT0vXE1/beLXRMP9upo3s9w89LcwYVksXZp8r8Tl3AkwDCV
                 code : |1-
                  <§rad:1§>
                  // Stored information<§rad:1§>
                  PageToFile()<§rad:1§>
                  <§rad:1§>
                  // If it's a new record<§rad:1§>
                  if gbCreationMode = True then<§rad:1§>
                  	// Add it<§rad:1§>
                  	utililisateur.Add()<§rad:1§>
                  else<§rad:1§>
                  	// Otherwise, modify it<§rad:1§>
                  	utililisateur.Modify()<§rad:1§>
                  end<§rad:1§>
                  <§rad:1§>
                  // Back to the previous page<§rad:1§>
                  if gsNamePreviousPage <>"" then<§rad:1§>
                  	PageDisplay(gsNamePreviousPage, MyPage.Name)<§rad:1§>
                  else<§rad:1§>
                  	PAGE_Home.Display()<§rad:1§>
                  end<§rad:1§>
                  <§rad:1§>
                  //Automatic management of errors<§rad:1§>
                  case Error:<§rad:1§>
                  Error("An error occurred during the validation.", HErrorInfo())<§rad:1§>
                  return<§rad:1§>
                  <§rad:1§>
                  <§rad:1§>
                 type : 851984
               -
                 type : 1310736
                 enabled : false
               -
                 type : 852149
                 role : B
                 enabled : false
