   -
     code : |1-
      procedure PAGE_ComptClientclient( gsNamePreviousPage is string ="" )<§rad:1§>
      <§rad:1§>
      //Implement the position and the filter applied to the file<§rad:1§>
      gbCreationMode is boolean = RADLoadPosition(client.Name)<§rad:1§>
      <§rad:1§>
      //In modification mode, display the record to modify <§rad:1§>
      if gbCreationMode = False then<§rad:1§>
      	FileToPage()<§rad:1§>
      end<§rad:1§>
      <§rad:1§>
      <§rad:1§>
      <§rad:1§>
