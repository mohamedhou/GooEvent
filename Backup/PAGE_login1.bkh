     code : |1-
      
      //-------------------------------------------------------------
      // Événement : Clic sur le bouton (Navigateur)
      // Rôle : Valider que les champs ne sont pas vides.
      //-------------------------------------------------------------
      
      // On s'assure que le message d'erreur précédent est caché.
      LIB_Erreur.Visible = Faux
      
      // On vérifie si un des champs est vide.
      // On utilise "..Valeur" car c'est le code navigateur.
      SI SAI_Email..Valeur = "" OU SAI_MotDePasse..Valeur = "" ALORS
      	
      	// Si un champ est vide, on affiche un message d'erreur.
      	LIB_Erreur..Valeur	= "Veuillez remplir tous les champs."
      	LIB_Erreur.Visible	= Vrai
      	
      	// On arrête tout. On n'envoie RIEN au serveur.
      	RETOUR
      FIN
