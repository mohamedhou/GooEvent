 code_elements :
  type_code : 31
  p_codes :
   -
     code : |1-
      PROCEDURE PROC_ClientLogin(sLoginJSON est une chaîne)
      
      HChangeConnection("*", MyConnection1)
      hLoginInfo est un objet dynamique = JSONVersVariant(sLoginJSON)
      
      SI hLoginInfo = Null OU hLoginInfo.?identifiant = Null OU hLoginInfo.?motdepasse = Null THEN
      	RENVOYER gCreerReponseJSON(Faux, "Données invalides.")
      END
      
      sIdentifiant		est une chaîne	= hLoginInfo.identifiant
      sMotDePasse			est une chaîne	= hLoginInfo.motdepasse
      
      bUtilisateurTrouve	est un booléen	= Faux
      
      // Recherche par email
      SI HLitRecherche(Client, email, sIdentifiant) = Vrai THEN
      	bUtilisateurTrouve = Vrai
      ELSE // Sinon, cherche par téléphone
      	SI HLitRecherche(Client, telephone, sIdentifiant) = Vrai THEN
      		bUtilisateurTrouve = Vrai
      	END
      END
      
      SI bUtilisateurTrouve = Faux THEN
      	RENVOYER gCreerReponseJSON(Faux, "Identifiant ou mot de passe incorrect.")
      END
      
      // Vérification du mot de passe
      SI Client.motdepasse <> HashChaîne(HA_SHA_256, sMotDePasse) THEN
      	RENVOYER gCreerReponseJSON(Faux, "Identifiant ou mot de passe incorrect.")
      END
      
      // Ici, Session DEVRAIT fonctionner car c'est une procédure AJAX exécutable
      Session.estConnecte	= Vrai
      Session.IDClient	= Client.IDClient
      
      RENVOYER gCreerReponseJSON(Vrai, "Connexion réussie.")
      FIN
     type : 720896
   -
