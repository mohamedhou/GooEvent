      //PROCEDURE PROC_ClientLogin(sDonneesJSON est une chaîne)
      //
      //// Étape 1 : Parser les données JSON
      //hReponse	est un objet dynamique
      //hLoginInfo	est un objet dynamique	= JSONVersVariant(sDonneesJSON)
      //
      //SI hLoginInfo = Null ALORS
      //	RENVOYER gCreerReponseJSON(Faux, "Données invalides.")
      //FIN
      //
      //sIdentifiant	est une chaîne	= hLoginInfo.identifiant
      //sMotDePasse		est une chaîne	= hLoginInfo.motdepasse
      //
      //// Étape 2 : Chercher le client par email OU téléphone
      //bTrouve			est un booléen	= Faux
      //
      //SI HLitRecherchePremier(client, email, sIdentifiant) ALORS
      //	bTrouve = Vrai
      //SINON
      //	SI HLitRecherchePremier(client, telephone, sIdentifiant) ALORS
      //		bTrouve = Vrai
      //	FIN
      //FIN
      //
      //SI bTrouve = Faux ALORS
      //	RENVOYER gCreerReponseJSON(Faux, "Identifiant ou mot de passe incorrect.")
      //FIN
      //
      //// Étape 3 : Vérification mot de passe
      //SI client.MotDePasse <> sMotDePasse ALORS
      //	RENVOYER gCreerReponseJSON(Faux, "Identifiant ou mot de passe incorrect.")
      //FIN
      //
      //// Étape 4 : Mise à jour session
      //Session.estConnecte	= Vrai
      //Session.IDClient	= client.IDClient
      //
      //// Étape 5 : Succès
      //RENVOYER gCreerReponseJSON(Vrai, "Connexion réussie.")
      //PROCEDURE MyPage()
